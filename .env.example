# Copy to .env.local and fill in values.
# In scaffold mode (no values), /api/generate runs a mock pipeline.

# ---------- Supabase (Part 8) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google Gemini (Google AI Studio API key) ----------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default: gemini-3-pro-image-preview (Gemini 3 Pro Image / Nano Banana Pro)
# GEMINI_MODEL=gemini-2.5-flash-image

# ---------- Vertex AI (optional — service account) ----------
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- Anthropic Claude (optional — prompt polish after engine + templates) ----------
ANTHROPIC_API_KEY=
# Optional. Default: claude-3-5-haiku-20241022
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------- Stripe (Part 9) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
