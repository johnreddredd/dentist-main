# Copy to .env.local and fill in values.
# In scaffold mode (no values), /api/generate runs a mock pipeline.
#
# ---------- Production URL (Railway / Vercel) ----------
# Patient share links use this when set (include https://).
# Example (this project): https://dentist-main-production.up.railway.app
# NEXT_PUBLIC_APP_URL=https://dentist-main-production.up.railway.app

# ---------- Supabase (case sync + auth) ----------
# Create a project at https://supabase.com — Project Settings → API for URL + anon key.
# Run the SQL in supabase/migrations/20250429120000_cases.sql (SQL Editor → New query).
# Auth → URL Configuration: add Site URL and Redirect URLs:
#   http://localhost:3000/auth/callback
#   https://YOUR-PRODUCTION-HOST/auth/callback
# For Google sign-in: Auth → Providers → Google (Web client ID/secret from Google Cloud).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: server-side admin (not required for current client-side sync)
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google Gemini (Google AI Studio API key) ----------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default: gemini-3-pro-image-preview (Gemini 3 Pro Image / Nano Banana Pro)
# GEMINI_MODEL=gemini-2.5-flash-image

# ---------- Vertex AI (optional — service account) ----------
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- Anthropic Claude (optional — prompt polish after engine + templates) ----------
ANTHROPIC_API_KEY=
# Optional. Default: claude-3-5-haiku-20241022
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ---------- Stripe (Part 9) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
